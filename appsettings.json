{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "DistributedCache:"
  },
  "Database": {
    "Name": "ProductsDb"
  },
  "Cache": {
    "AbsoluteExpirationMinutes": 5,
    "SlidingExpirationMinutes": 2,
    "ProductKeyPrefix": "product"
  }
}
